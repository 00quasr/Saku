# Saku – lokale Einstellungen
# Diese Datei nach .env kopieren und den API-Schlüssel eintragen.
# .env steht in .gitignore und landet nie im Repo.

# Schlüssel aus der Claude Console
ANTHROPIC_API_KEY=

# Modelle, aktuelle Namen:
# https://platform.claude.com/docs/en/about-claude/models/overview
SAKU_MODELL_SCHNELL=claude-haiku-5-5
SAKU_MODELL_STARK=claude-sonnet-5-5

# Optional
SAKU_DATENORDNER=data
SAKU_PORT=5050
